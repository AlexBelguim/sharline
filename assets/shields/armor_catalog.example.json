{
  "schema_version": 3,
  "notes": "Example halo-shield armor catalog for the HALO kit (assets/shields/, see NOTES.md). Generated by make_catalog.py: every gameplay number is read from game/assets/data/armor.ron at build time and cross-checked against design/systems/data/armors.slice.json (the build fails if they disagree). The game's data files stay the source of truth. Food/energy drain multipliers are art-side placeholders.",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "HaloArmor",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "core",
      "tier",
      "coverage",
      "weight_class",
      "capacity",
      "regen_per_s",
      "power_cells",
      "food_drain_mult",
      "energy_drain_mult",
      "move_speed_mult",
      "status_effect"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$",
        "description": "Stable item id (loot tables, saves)."
      },
      "name": {
        "type": "string",
        "description": "Display name (placeholder)."
      },
      "source": {
        "type": "string",
        "description": "Where the arc tiers come from (game preset or art example)."
      },
      "core": {
        "enum": [
          "Bulwark",
          "Mender",
          "Volt",
          "Phase"
        ],
        "description": "Ring silhouette: HALO_<core>_Arc_* glass + one HALO_<core>_Frame_<weight> mesh, cells HALO_PowerCell_<core>, HALO_Core_<core> pickup."
      },
      "tier": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4,
        "description": "Headline tier = highest arc tier. Number of tier pips shown (centred row HALO_<core>_PIP_<tier>_1..<tier>) and the pip/cell/band-lip colour."
      },
      "coverage": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "uniqueItems": true,
        "items": {
          "enum": [
            "head",
            "torso",
            "arms",
            "legs"
          ]
        },
        "description": "Covered zones = arcs with tier > 0 (head = front arc, arms = +X, torso = back, legs = -X)."
      },
      "arc_tiers": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "head": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "torso": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "arms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "legs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        },
        "description": "Per-arc tier (game/DESIGN_DELTAS.md #2). 0 = uncovered (dark arc). Each arc glows in its own tier colour."
      },
      "weight_class": {
        "enum": [
          "Light",
          "Medium",
          "Heavy"
        ],
        "description": "From protection_score via rules.weight_bands. Drives halo scale, weight band mesh, cell count, orbit."
      },
      "protection_score": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16,
        "description": "Sum of the arc tiers (= tier x zones when uniform)."
      },
      "capacity": {
        "type": "number",
        "exclusiveMinimum": 0,
        "description": "Total shield HP = sum of arc_capacity."
      },
      "arc_capacity": {
        "type": "object",
        "additionalProperties": {
          "type": "number"
        },
        "description": "Shield pool per covered arc = rules.capacity[core][arc tier] x rules.zone_capacity_share[zone]."
      },
      "regen_per_s": {
        "type": "number",
        "minimum": 0,
        "description": "Shield HP regenerated per second per arc after the delay."
      },
      "regen_delay_s": {
        "type": "number",
        "minimum": 0,
        "description": "Seconds without damage before regen starts."
      },
      "regen_delay_after_break_s": {
        "type": "number",
        "minimum": 0,
        "description": "Longer delay after an arc broke."
      },
      "power_cells": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3,
        "description": "Orbiting HALO_PowerCell_<core> count (1 Light, 2 Medium, 3 Heavy)."
      },
      "food_drain_mult": {
        "type": "number",
        "minimum": 0.5,
        "maximum": 2.0,
        "description": "Multiplier on the hunger drain rate while worn (art-side placeholder)."
      },
      "energy_drain_mult": {
        "type": "number",
        "minimum": 0.5,
        "maximum": 2.0,
        "description": "Multiplier on the energy drain rate while worn (art-side placeholder)."
      },
      "energy_drain_per_min": {
        "type": "number",
        "minimum": 0,
        "description": "Game value (absolute extra energy drain per minute)."
      },
      "move_speed_mult": {
        "type": "number",
        "minimum": 0.7,
        "maximum": 1.0,
        "description": "Multiplier on base movement speed."
      },
      "status_effect": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "enum": [
              "steady",
              "fast_regen",
              "break_shock",
              "slow_immune"
            ]
          },
          "description": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "description": "Core effect; also selects the cell trail / pulse look and hit-particle behaviour (rules.status_vfx)."
      }
    }
  },
  "rules": {
    "zones_to_arcs": {
      "head": "HALO_<core>_Arc_Head",
      "torso": "HALO_<core>_Arc_Torso",
      "arms": "HALO_<core>_Arc_Arms",
      "legs": "HALO_<core>_Arc_Legs"
    },
    "tier_colors_linear_rgb": {
      "1": [
        0.85,
        0.88,
        0.92
      ],
      "2": [
        0.1,
        0.45,
        1.0
      ],
      "3": [
        0.55,
        0.15,
        1.0
      ],
      "4": [
        1.0,
        0.62,
        0.08
      ]
    },
    "protection_score": "sum(arc_tiers)",
    "weight_bands": {
      "Light": [
        1,
        4
      ],
      "Medium": [
        5,
        8
      ],
      "Heavy": [
        9,
        16
      ]
    },
    "loadout_tier_caps": {
      "head": 4,
      "torso": 4,
      "arms": 3,
      "legs": 2
    },
    "weight_class_effects": {
      "Light": {
        "move_speed_mult": 1.0,
        "power_cells": 1,
        "energy_drain_per_min": 2.0,
        "food_drain_mult": 1.0,
        "energy_drain_mult": 1.1
      },
      "Medium": {
        "move_speed_mult": 0.95,
        "power_cells": 2,
        "energy_drain_per_min": 4.0,
        "food_drain_mult": 1.05,
        "energy_drain_mult": 1.2
      },
      "Heavy": {
        "move_speed_mult": 0.88,
        "power_cells": 3,
        "energy_drain_per_min": 8.0,
        "food_drain_mult": 1.15,
        "energy_drain_mult": 1.4
      }
    },
    "energy_drain_core_adjust": {
      "Phase": -0.05,
      "Bulwark": 0.05
    },
    "weight_class_visuals_note": "halo_scale scales the whole halo root; orbit_radius_local and orbit_height_local are in the root's local space (world metres = value x halo_scale). orbit_height_local is above the ring plane (Blender +Z, glTF +Y) so the cells clear the ring top at eye level.",
    "weight_class_visuals": {
      "Light": {
        "halo_scale": 0.85,
        "band_mesh": null,
        "power_cells": 1,
        "orbit_radius_local": 0.215,
        "orbit_height_local": 0.058,
        "orbit_period_s": 2.6
      },
      "Medium": {
        "halo_scale": 1.0,
        "band_mesh": "Medium",
        "power_cells": 2,
        "orbit_radius_local": 0.245,
