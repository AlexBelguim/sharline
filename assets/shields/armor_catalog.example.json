      "power_cells": 2, "food_drain_mult": 1.10, "energy_drain_mult": 1.20, "move_speed_mult": 0.95,
      "status_effect": {"id": "steady", "description": "Reduced aim flinch while the shield is up.",
                        "params": {"flinch_reduction": 0.35}}
    },
    {
