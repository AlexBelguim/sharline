      "weight_class": "Light", "protection_score": 4, "capacity": 48, "regen_per_s": 6.0, "regen_delay_s": 3.0,
      "power_cells": 1, "food_drain_mult": 1.00, "energy_drain_mult": 1.05, "move_speed_mult": 1.00,
      "status_effect": {"id": "passive_regen", "description": "Keeps trickle-regenerating even while taking fire.",
                        "params": {"in_combat_regen_per_s": 1.0}}
    },
    {
      "id": "phase_t4_glass", "name": "Glassline Phase", "core": "Phase", "tier": 4, "coverage": ["torso"],
      "weight_class": "Light", "protection_score": 4, "capacity": 37, "regen_per_s": 4.5, "regen_delay_s": 4.0,
      "power_cells": 1, "food_drain_mult": 0.95, "energy_drain_mult": 1.00, "move_speed_mult": 1.00,
      "status_effect": {"id": "phase_resist", "description": "Strong slow and bleed resistance; gold glow on a light frame.",
                        "params": {"slow_resist": 0.40, "bleed_resist": 0.40}}
    },
    {
      "id": "volt_t2_breacher", "name": "Breacher Volt", "core": "Volt", "tier": 2, "coverage": ["head", "torso", "arms"],
      "weight_class": "Medium", "protection_score": 6, "capacity": 84, "regen_per_s": 3.0, "regen_delay_s": 5.0,
      "power_cells": 2, "food_drain_mult": 1.10, "energy_drain_mult": 1.15, "move_speed_mult": 0.96,
      "status_effect": {"id": "break_shock", "description": "When the shield breaks, a shock pulse slows nearby enemies.",
