// Fluffy hedges and lawn grass on Showhome (val_etf/src/foliage.rs and foliage/grass.rs; shaders
// assets/shaders/foliage.wgsl and grass.wgsl). Groups of four follow the VIDEO quality preset: [LOW, MEDIUM, HIGH,
// ULTRA]. A density (or layer count) of 0 turns that part off (LOW draws the plain textured hedge boxes and the
// flat lawn). Lengths are metres, colours linear RGB.
(
    hedge: (
        // Leaf-cluster cards per square metre of hedge surface. The cards are merged into one mesh per hedge.
        density: (0.0, 12.0, 16.0, 20.0),
        // Card edge length, smallest and largest.
        card_size: (0.32, 0.6),
        // The opaque core: the hedge box shrunk by this much, its top and side edges rounded by core_radius.
        core_inset: 0.12,
        core_radius: 0.30,
        // The card centres sit on the hedge box shrunk by shell_inset with edges rounded by shell_radius, then
        // move along the surface normal by a random amount in `poke`: tilted cards stick out 8-20 cm.
        shell_inset: 0.03,
        shell_radius: 0.38,
        poke: (-0.06, 0.06),
        // Random tilt of each card away from the surface, and roll on the sides (degrees). The clumps are painted
        // lit from above, so side cards stay roughly upright; cards on the top roll freely.
        tilt_deg: 26.0,
        roll_deg: 30.0,
        // Card normals are bent outward from the hedge's rounded volume (a box rounded by this radius, capped at
        // half the hedge's thickness), mixed with a little of the card's own normal and of a sphere around each
        // card (so every clump has a lit top and a darker underside).
        normal_radius: 0.9,
        normal_card_mix: 0.15,
        normal_clump_mix: 0.12,
        // AO by depth: a card corner this far inside the shell surface is darkened to ao_min.
        ao_depth: 0.24,
        ao_min: 0.22,
        // Each clump's underside (the card corners below its centre) is darkened to this.
        clump_shade: 0.85,
        // The bottom of the hedge is darker, up to ground_ao_height above the ground.
        ground_ao: 0.62,
        ground_ao_height: 1.0,
        // Per-card value and hue jitter (fraction).
        value_jitter: 0.10,
        hue_jitter: 0.06,
        // Multiplies the card atlas (built to the palette hedge colour) and the core (hedge_leaves.png).
        tint: (0.8, 0.74, 0.7),
        core_tint: (0.26, 0.26, 0.2),
        roughness: 0.82,
        reflectance: 0.3,
        alpha_cutoff: 0.5,
        // Light wrap past the terminator and sun-through-leaves translucency (a share of the sun's diffuse light).
        wrap: 0.45,
        translucency: 0.35,
        translucency_power: 3.0,
        // The cards are lit as if they stood this much further toward the sun: out of the hedge, so its core
        // and the other cards never shadow them (no acne; the bent normals and the AO do the self-shading), while
        // houses and walls still do.
        shadow_probe: 0.6,
        // Wind: sway of the outermost card corners.
        wind_amplitude: 0.022,
    ),
    grass: (
        // The mown lawn: shells over the art kit's lawn surfaces (ground.glb, M_GND_Grass), coloured from the lawn's
        // own ground texture. Layer 0 is a dark thatch just above the ground; the others carry the strands.
        lawn: (
            // Shell layers, the thatch included (0 = the flat lawn only).
            layers: (0, 6, 10, 14),
            // Height of the longest strands (a mown lawn is 3-5 cm).
            height: 0.04,
            // Strands: one per cell of two overlapping jittered grids `spacing` apart (the second 1.31x larger and
            // turned); root radius as a share of a cell; the shortest strand as a share of `height`; tip lean as a
            // share of a cell.
            spacing: 0.011,
            radius: 0.30,
            shortest: 0.55,
            lean: 0.16,
            // Strands thin out from fade_start to fade_end (metres from the camera) while the colour settles to the
            // plain ground; past fade_end only the ground is drawn.
            fade_start: (0.0, 4.0, 6.0, 7.0),
            fade_end: (0.0, 10.0, 14.0, 16.0),
            // Brightness over the lawn texture at the roots (the thatch) and at the tips; the tips' tint (linear).
            root_shade: 0.55,
            tip_lift: 1.12,
            tip_tint: (1.03, 1.02, 0.90),
            // Per-strand brightness jitter; slow, irregular colour patches: brightness (share), size (metres), and the
            // tints of the driest and the lushest patches.
            value_jitter: 0.10,
            patch_strength: 0.10,
            patch_scale: 2.8,
            dry_tint: (1.05, 1.0, 0.86),
            lush_tint: (0.90, 1.0, 0.94),
            // Strands thin out where the ground blend masks (worn dirt R, gravel G, mud A) go from the first value
            // to the second (a triangle past the second in one mask is left out).
            dirt_thin: (0.30, 0.62),
            // Lawn chunk size: one mesh per chunk, drawn once per layer.
            chunk: 8.0,
            // Wind: sway of the strand tips (metres), the sheen of gusts running over the lawn (share of brightness),
            // and the sway speed relative to the wind frequency.
            wind_sway: 0.004,
            wind_sheen: 0.06,
            sway_speed: 1.0,
        ),
        // Taller tufts along fences, walls, hedge bases, kerbs and the lawn's other edges, in irregular patches.
        tufts: (
            // Tufts per square metre right at an edge, inside a patch (0 = none).
            density: (0.0, 14.0, 24.0, 30.0),
            // They grow up to `band` metres from an edge (the lawn's outline, or the foot of anything standing on
            // it), most of them right at it.
            band: 0.4,
            // Tuft height (never enough to hide a crouched player), blades per tuft, blade width at the root, and
            // how far the blade roots spread around the tuft's centre.
            height: (0.10, 0.25),
            blades: (7, 12),
            blade_width: 0.018,
            spread: 0.05,
            // Blades lean out from the tuft's centre by this much (degrees), curving more toward the tip.
            lean_deg: (8.0, 32.0),
            // Patches along the edges: noise size (metres), the share of the lawn's outline they cover (kerbs, edging,
            // paths), and the share of the foot of fences, walls and hedges (no mower reaches there).
            patch_scale: 2.4,
            patch_cover: 0.45,
            foot_cover: 0.85,
            // Tufts give out where the ground blend masks (worn dirt, gravel, mud) go from the first value to the
            // second.
            dirt_limit: (0.45, 0.75),
            // Tufts shrink into the lawn from fade_start to fade_end (metres from the camera).
            fade_start: (0.0, 12.0, 16.0, 20.0),
            fade_end: (0.0, 20.0, 26.0, 32.0),
            // Brightness over the lawn colour at the root and at the tip; the tips' tint; per-blade jitter.
            root_shade: 0.50,
            tip_lift: 1.15,
            tip_tint: (1.06, 1.04, 0.84),
            value_jitter: 0.12,
            // Wind: sway of the tips (metres) and speed relative to the wind frequency.
            wind_amplitude: 0.035,
            sway_speed: 1.6,
            // Tuft chunk size (one mesh each), and how far outside the play area lawns still get tufts.
            chunk: 12.0,
            reach: 30.0,
        ),
    ),
    wind: (
        // Direction the wind blows toward (degrees, 0 = east, 90 = north), hedge sway in cycles per second (the
        // grass sways sway_speed times faster), wave length along the wind.
        direction_deg: 30.0,
        frequency: 0.4,
        wavelength: 7.0,
        // A slow gust that leans everything a little downwind (fraction of the amplitude).
        gust: 0.35,
    ),
)
