// Settings screen (design/ui/mockups 08-08e, game/crates/val_etf/src/settings): defaults for a new player,
// the range of every slider and number field, and the tables the screen uses. A player's own choices are
// saved separately, as settings.ron in their config folder; this file only says where they start.
(
    ranges: (
        dpi: (min: 100, max: 32000, step: 1),
        // Typed turn distances accept 5-150 cm; the slider draws 15-80 cm.
        cm_per_360: (min: 5.0, max: 150.0, step: 0.1, track: Some((15.0, 80.0))),
        import_sens: (min: 0.001, max: 100.0, step: 0.001),
        // 1.00 sits mid-track (the mockup's 50 % fill).
        optic_mult: (min: 0.10, max: 2.00, step: 0.01, track: Some((0.0, 2.0))),
        fov_h: (min: 80, max: 110, step: 1),
        viewmodel_fov: (min: 54, max: 82, step: 1),
        // Crosshair lines, px at 1080p.
        xh_length: (min: 0, max: 20, step: 1),
        xh_gap: (min: 0, max: 20, step: 1),
        xh_width: (min: 1, max: 6, step: 1),
        render_scale: (min: 50, max: 125, step: 5),
        brightness: (min: -50, max: 50, step: 1),
        volume: (min: 0, max: 100, step: 1),
        hud_scale: (min: 80, max: 120, step: 5),
        safe_area: (min: 0, max: 100, step: 1),
        screen_shake: (min: 0, max: 100, step: 5),
        // Hold reload (or heal) this long to open the ring; a shorter tap reloads the next magazine.
        radial_hold_s: (min: 0.10, max: 0.50, step: 0.05),
        // The ring cursor's dead zone, px (spec 13's proposal; not a setting yet, so the row is disabled).
        radial_dead_zone: (min: 10, max: 30, step: 1),
        host_port: (min: 1024, max: 65535, step: 1),
    ),
    // The crosshair opens by the gun's spread beyond this much of its resting hip spread (degrees), so a rifle
    // at rest shows the plain small cross while a gun that is wide even at rest (the Warden's hip fire) shows
    // the rest of its cone.
    crosshair: (rest_allowance_deg: 1.0),
    // The ring menus' cursor: px (at 1080p) per inch of mouse travel (at 800 DPI one count is one px, like a
    // desktop cursor), and how far (px) it must move off the centre before an option is picked.
    radial: (px_per_inch: 800.0, dead_zone_px: 24.0),
    // Degrees of yaw per mouse count in the games the import box converts from (a factual conversion).
    import_yaw: (valorant: 0.07, cs2: 0.022, apex: 0.022, overwatch2: 0.0066),
    // One ADS row per group of optics (attachments.ron ids); every optic needs a row. Multipliers are saved per
    // optic id, so new optics only need a row here: one added to a row takes the row's value from a player's
    // older settings file. The label names every optic of its row.
    optic_rows: [
        (
            label: "Holo / red dot / projector",
            sub: Some("1× sights, zoom 1.15–1.25×"),
            optics: ["optic_holo", "optic_reddot", "optic_projector"],
        ),
        (label: "3× prism", optics: ["optic_3x"]),
        (label: "Thermal 4×", optics: ["optic_thermal"]),
        (label: "Sniper 6× / 12×", sub: Some("Per zoom step, same feel at every step"), optics: ["optic_sniper"]),
    ],
    // Brightness ±50 is ± this many EV of camera exposure.
    brightness_ev: 1.0,
    // Text size S / M / L on HUD text.
    text_size_scale: (0.9, 1.0, 1.15),
    // Shadow LOW / MEDIUM / HIGH: shadow-map size per cascade and cascade count.
    shadows: (map_size: (1024, 2048, 4096), cascades: (1, 2, 4)),
    presets: (
        low: (aa: Fxaa, shadows: Low, bloom: Off, particles: Low, contact_shadows: false, ssr: false),
        medium: (aa: Smaa, shadows: Medium, bloom: Low, particles: Low, contact_shadows: true, ssr: false),
        high: (aa: Smaa, shadows: High, bloom: Low, particles: High, contact_shadows: true, ssr: false),
        ultra: (aa: Taa, shadows: High, bloom: High, particles: High, contact_shadows: true, ssr: true),
    ),
    // Frame caps offered next to the monitor's own refresh rate.
    frame_limits: [60, 144, 240],
    defaults: (
        // The settings file format (settings::SETTINGS_VERSION). A saved file of an older version is migrated
        // once on load: a value that still holds an old default moves to the new one (settings/model.rs).
        version: 1,
        last_tab: MouseAim,
        gameplay: (
            // Moving forward sprints; hold Walk (Shift) to walk (user direction 2026-10-08).
            auto_sprint: true,
            jetpack: HoldJumpInAir,
            slide: CrouchWhileSprinting,
            mag_card: ThreeSeconds,
            radial_hold_s: 0.20,
            radial_pick: Release,
        ),
        // The game's port (net.ron), not the mockup's 7777.
        network: (host_port: 47820),
        mouse: (
            dpi: 800,
            // = Valorant 0.400 at 800 DPI
            cm_per_360: 40.8,
            import_game: Valorant,
            ads_scaling: MatchFocal,
            optic_mult: {},
            ads_input: Hold,
            invert_y: false,
            fov_h: 103,
            viewmodel_fov: 68,
        ),
        // A small plus (user direction 2026-10-08).
        crosshair: (
            color: "#F3F0E9",
            outline: true,
            dot: false,
            length: 4,
            gap: 2,
            width: 2,
            hit_markers: ShieldFlesh,
        ),
        // Today's controls (game/README.md). Esc is the match menu and not bindable; 1-6 pick a magazine
        // while the reload radial is open. Auto-sprint is on, so Shift walks and Sprint (Alt) is for players who
        // turn it off; scoped, Shift also holds your breath. B heals, H switches the fire mode.
        keybinds: {
            MoveForward: (Some("KeyW"), None),
            MoveLeft: (Some("KeyA"), None),
            MoveBack: (Some("KeyS"), None),
            MoveRight: (Some("KeyD"), None),
            Jump: (Some("Space"), Some("WheelDown")),
            Sprint: (Some("AltLeft"), None),
            Walk: (Some("ShiftLeft"), None),
            Crouch: (Some("ControlLeft"), Some("KeyC")),
            Interact: (Some("KeyF"), None),
            Fire: (Some("MouseLeft"), None),
            Ads: (Some("MouseRight"), None),
            Reload: (Some("KeyR"), None),
            MagCheck: (Some("KeyT"), None),
            FireMode: (Some("KeyH"), None),
            Underbarrel: (Some("KeyG"), None),
            Laser: (Some("KeyV"), None),
            Melee: (Some("Digit3"), None),
            HoldBreath: (Some("ShiftLeft"), None),
            Ability1: (Some("KeyQ"), None),
            Signature: (Some("KeyE"), None),
            Ultimate: (Some("KeyX"), None),
            Heal: (Some("KeyB"), None),
            Scoreboard: (Some("Tab"), None),
            Ping: (Some("MouseMiddle"), Some("KeyZ")),
            Chat: (Some("Enter"), Some("KeyY")),
            ChangeLoadout: (Some("KeyL"), None),
        },
        video: (
            window_mode: Borderless,
            resolution: None,
            render_scale: 100,
            frame_limit: Monitor,
            vsync: false,
            brightness: 0,
            overlay: Fps,
            preset: High,
            aa: Smaa,
            // The mockup's state: the HIGH preset with medium shadows (the micro reads 'HIGH · CUSTOM').
            shadows: Medium,
            outlines: true,
            bloom: Low,
            particles: High,
            contact_shadows: true,
            ssr: false,
            motion_blur: false,
            vignette: false,
        ),
        audio: (
            master: 80,
            weapons: 90,
            movement: 100,
            abilities: 85,
            hits: 70,
            interface: 60,
            music: 40,
            output_device: "System default",
            mix: Headphones,
            shield_hit: true,
            headshot: true,
            // An approximate cue at most (open design question): never an exact count.
            low_mag_cue: false,
            play_in_background: false,
        ),
        hud: (
            scale: 100,
            safe_area: 32,
            ultrawide: Centre,
            health_numbers: Show,
            minimap: NorthUp,
            damage_numbers: false,
            kill_feed: Five,
            enemy_names: OnScanAim,
            team_colours: Default,
            enemy_outline: On,
            screen_shake: 60,
            damage_flash: Soft,
            reduce_flashing: false,
            text_size: M,
            hold_toggle: Hold,
        ),
    ),
)
