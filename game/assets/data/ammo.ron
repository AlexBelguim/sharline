// Ammo (user direction, see game/DESIGN_DELTAS.md). A loadout loads ONE ammo for its gun, picked as a type
// and a tier (e.g. AP II); there is no per-round or per-magazine sorting.
//
// `pen` is a SHIELD-DAMAGE MULTIPLIER per halo tier: a bullet does damage x pen[tier] to a covered arc's
// shield. Zone HP takes nothing while the arc holds; the bullet that breaks it carries its leftover on
// (leftover = (shield damage - absorbed) / pen). pen 1.0 = normal, < 1 = that tier resists the round.
//
//   class pen[t] x pen_mult   -> shield-damage multiplier vs a tier-t arc
//   damage_mult               -> the whole bullet (shield and HP)
//   flesh_mult                -> HP damage only
//   spill_mult                -> broken-limb -> torso spill (arms 0.6 / legs 0.7), capped at spill_cap
//   bypass_chance             -> chance a hit ignores the shield (Shrapnel)
//   bleed                     -> HP/s per stack on the hit zone until treated; a residual stays to respawn
//   gear_cost                 -> points against the team-deathmatch gear budget (rules.ron)
// Omitted tier fields default to 1 / 0 / None.
(
    spill_cap: 1.0,
    classes: {
        // User example: SMG rounds only slightly out-damage normal against T1 arcs and nothing above.
        smg: (pen: (1.1, 1.0, 1.0, 1.0)),
        light_assault: (pen: (1.1, 1.05, 1.0, 1.0)),
        // Neutral: the Mako stays on the design's numbers (the design's Mako pierced nothing).
        assault_rifle: (pen: (1.0, 1.0, 1.0, 1.0)),
        heavy_assault: (pen: (1.25, 1.15, 1.05, 1.0)),
        shotgun: (pen: (1.0, 1.0, 1.0, 1.0)),
        bolt_sniper: (pen: (1.6, 1.6, 1.6, 1.6)),
    },
    types: {
        Standard: (label: "STD", tiers: [()]),
        // High damage, high pen: the shield breaker. Paid for with gear budget.
        ArmorPiercing: (
            label: "AP",
            tiers: [
                (pen_mult: 1.3, damage_mult: 1.05, gear_cost: 2),
                (pen_mult: 1.6, damage_mult: 1.1, gear_cost: 4),
                (pen_mult: 2.0, damage_mult: 1.15, gear_cost: 6),
            ],
        ),
        // SMG only. Expanding rounds: bad into shields, brutal on flesh, and they carry more limb damage
        // on into the torso, which makes spraying legs a real option.
        Rip: (
            label: "RIP",
            only: [smg],
            tiers: [
                (pen_mult: 0.85, flesh_mult: 1.12, spill_mult: 1.2, gear_cost: 1),
                (pen_mult: 0.8, flesh_mult: 1.2, spill_mult: 1.35, gear_cost: 2),
                (pen_mult: 0.75, flesh_mult: 1.28, spill_mult: 1.45, gear_cost: 3),
            ],
        ),
        // NPC-only (bots and bosses in the extraction mode): weak, but fragments sometimes slip past the
        // shield and leave a bleed that never fully goes away.
        Shrapnel: (
            label: "SHR",
            player_loadout: false,
            tiers: [
                (pen_mult: 0.7, damage_mult: 0.8, bypass_chance: 0.1, bleed: Some((hp_per_s: 1.5, max_stacks: 3, residual_hp_per_s: 0.25))),
                (pen_mult: 0.7, damage_mult: 0.8, bypass_chance: 0.15, bleed: Some((hp_per_s: 2.0, max_stacks: 3, residual_hp_per_s: 0.3))),
                (pen_mult: 0.7, damage_mult: 0.8, bypass_chance: 0.2, bleed: Some((hp_per_s: 2.5, max_stacks: 3, residual_hp_per_s: 0.4))),
            ],
        ),
        // Shotgun only: one heavy projectile; low pen, high damage.
        Slug: (
            label: "SLUG",
            only: [shotgun],
            tiers: [(pen_mult: 0.8, damage_mult: 1.8, gear_cost: 1), (pen_mult: 0.85, damage_mult: 2.1, gear_cost: 2)],
        ),
    },
)
