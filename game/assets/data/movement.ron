// Character movement. Mirrors the `movement` block of design/systems/data/movement.slice.json, except where the
// user changed the direction since (game/DESIGN_DELTAS.md): a slide starts from a normal run, not only a full
// sprint (`slide.min_entry_speed`, plus the forward cone `slide.entry_max_angle_deg`), and the jetpack allows
// aiming (`jetpack.ads_allowed`).
// Units: metres, seconds, m/s, m/s^2, degrees. Speeds are for no / Light halo; heavier halos scale
// them through `weight_effects` in armor.ron.
(
    capsule: (radius: 0.32, height_stand: 1.8, height_crouch: 1.25, height_slide: 1.0),
    // eye_height.clearance: the eye keeps this far from walls and ceilings (it is held down under a low gap
    // while it eases toward a slide's height), more than the camera's near plane reaches.
    eye_height: (stand: 1.6, crouch: 1.1, slide: 0.85, transition_s: 0.15, clearance: 0.08),
    // sprint_gun_hold_s: after its last shot the gun stays up this long before a sprint lowers it again.
    speed: (
        walk: 2.6,
        jog: 4.8,
        sprint: 7.0,
        crouch: 2.4,
        backpedal_mult: 0.85,
        sprint_max_angle_deg: 45.0,
        sprint_gun_hold_s: 0.6,
    ),
    ground: (
        accel: 40.0,
        decel: 36.0,
        counter_strafe_extra_decel: 20.0,
        step_height: 0.35,
        max_slope_deg: 46.0,
        ground_snap: 0.25,
    ),
    air: (
        gravity: 19.0,
        jump_height: 1.0,
        jump_v0: 6.16,
        coyote_s: 0.1,
        jump_buffer_s: 0.1,
        air_accel: 14.0,
        air_wish_speed: 1.2,
        terminal_speed: 40.0,
        max_horizontal_speed: 12.0,
        max_horizontal_speed_boosted: 16.0,
    ),
    fall_damage: (free_drop_m: 7.0, legs_hp_per_m: 12.0),
    slide: (
        // Below jog (4.8) and backpedal (4.08 = jog x 0.85), well above walk (2.6) and crouch (2.4). Scaled like the
        // run itself by the halo weight and the gun with its attachments (Heavy + Warden: 3.27 against a 3.93 jog),
        // so every loadout slides from its own run; an item in use or a wound slow does not lower it.
        min_entry_speed: 4.0,
        // Moving within this angle of the facing: run or sprint forward (diagonals included), not a strafe.
        entry_max_angle_deg: 60.0,
        boost: 2.0,
        boost_cooldown_s: 2.0,
        friction: 4.5,
        end_speed: 3.6,
        downhill_min_deg: 8.0,
        max_speed: 13.0,
        jump_keep_frac: 0.9,
        steer_deg_per_s: 90.0,
    ),
    mantle: (
        min_ledge: 0.6,
        max_ledge: 2.2,
        low_max: 1.2,
        time_low_s: 0.35,
        time_high_s: 0.55,
        probe_forward: 0.6,
        min_ledge_depth: 0.4,
        min_headroom: 1.25,
    ),
    jetpack: (
        fuel_s: 1.6,
        kick_up_mps: 3.0,
        kick_cost_s: 0.12,
        min_fuel_frac: 0.1,
        thrust: 32.0,
        climb_cap: 6.0,
        air_accel: 18.0,
        horizontal_cap: 7.0,
        regen_delay_s: 1.0,
        regen_full_s: 3.2,
        // Thrust fades linearly to zero between these heights above the take-off ground.
        fade_band_m: {Light: (4.0, 5.0), Medium: (3.6, 4.6), Heavy: (3.0, 4.0)},
        // Design check values: the highest feet rise from a standing start (jump + full jet).
        max_rise_m: {Light: 5.65, Medium: 5.25, Heavy: 4.65},
        fire_spread_add_deg: 3.0,
        ads_allowed: true,
    ),
    zipline: (
        attach_radius: 1.2,
        snap_s: 0.15,
        speed_flat: 11.0,
        speed_min: 8.0,
        speed_max: 13.0,
        accel_s: 0.3,
        detach_keep_frac: 0.7,
        detach_up: 5.0,
        end_hop_up: 3.0,
        reattach_block_s: 0.5,
    ),
    noise_radius_m: (
        walk: 0.0,
        crouch: 0.0,
        jog: 18.0,
        sprint: 28.0,
        slide: 24.0,
        land: 22.0,
        jet_start: 45.0,
        jet_loop: 40.0,
        zipline: 30.0,
        mantle: 12.0,
        reload: 8.0,
        mag_check: 5.0,
        heavy_mult: 1.2,
        kestrel_mult: 0.75,
    ),
)
