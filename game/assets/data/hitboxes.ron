        (zone: torso, center: (0.0, 1.145, 0.0), half: (0.22, 0.325, 0.14)),
        (zone: arms, center: (-0.29, 1.11, 0.0), half: (0.06, 0.31, 0.07)),
        (zone: arms, center: (0.29, 1.11, 0.0), half: (0.06, 0.31, 0.07)),
