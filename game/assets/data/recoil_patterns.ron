// Learnable view-kick patterns. Based on design/systems/data/mako_recoil_pattern.json, made much stronger after
// playtest round 1 (user direction, game/DESIGN_DELTAS.md section 9): recoil control is the skill check.
// Each kick is the view rotation (degrees, pitch up +, yaw right +) applied after shot `after_shot`.
// Past the last kick, the pattern loops from `loop_from_index` (0-based) for extended magazines.
{
    "mako_recoil_pattern": (
        // Shots 1-10 climb hard (8.87 deg, about twice the design's 4.37) while drifting a little right; 11-20 keep
        // climbing (3.77 deg; the design's went flat) and swing back left; the loop keeps climbing 0.35 deg a shot
        // and sways right then left (its yaw sums to zero). Aimed, every kick is x0.7.
        loop_from_index: 20,
        kicks: [
            (after_shot: 1, pitch: 1.0, yaw: 0.0),
            (after_shot: 2, pitch: 1.1, yaw: 0.05),
            (after_shot: 3, pitch: 1.15, yaw: -0.06),
            (after_shot: 4, pitch: 1.1, yaw: 0.08),
            (after_shot: 5, pitch: 1.0, yaw: 0.12),
            (after_shot: 6, pitch: 0.9, yaw: 0.16),
            (after_shot: 7, pitch: 0.8, yaw: 0.18),
            (after_shot: 8, pitch: 0.7, yaw: 0.16),
            (after_shot: 9, pitch: 0.6, yaw: 0.1),
            (after_shot: 10, pitch: 0.52, yaw: 0.02),
            (after_shot: 11, pitch: 0.46, yaw: -0.08),
            (after_shot: 12, pitch: 0.42, yaw: -0.16),
            (after_shot: 13, pitch: 0.4, yaw: -0.22),
            (after_shot: 14, pitch: 0.38, yaw: -0.26),
            (after_shot: 15, pitch: 0.36, yaw: -0.26),
            (after_shot: 16, pitch: 0.35, yaw: -0.22),
            (after_shot: 17, pitch: 0.35, yaw: -0.14),
            (after_shot: 18, pitch: 0.35, yaw: -0.04),
            (after_shot: 19, pitch: 0.35, yaw: 0.06),
            (after_shot: 20, pitch: 0.35, yaw: 0.14),
            (after_shot: 21, pitch: 0.35, yaw: 0.2),
            (after_shot: 22, pitch: 0.35, yaw: 0.22),
            (after_shot: 23, pitch: 0.35, yaw: 0.18),
            (after_shot: 24, pitch: 0.35, yaw: 0.08),
            (after_shot: 25, pitch: 0.35, yaw: -0.06),
            (after_shot: 26, pitch: 0.35, yaw: -0.18),
            (after_shot: 27, pitch: 0.35, yaw: -0.22),
            (after_shot: 28, pitch: 0.35, yaw: -0.16),
            (after_shot: 29, pitch: 0.35, yaw: -0.06),
        ],
    ),
    "skink_recoil_pattern": (
        // The Mako's pattern x0.6: the same learnable shape, lighter on every shot. At 1200 rpm it climbs
        // 7.58 deg in its first second (20 shots) against the Mako's 9.75 (12 shots).
        loop_from_index: 20,
        kicks: [
            (after_shot: 1, pitch: 0.6, yaw: 0.0),
            (after_shot: 2, pitch: 0.66, yaw: 0.03),
            (after_shot: 3, pitch: 0.69, yaw: -0.036),
            (after_shot: 4, pitch: 0.66, yaw: 0.048),
            (after_shot: 5, pitch: 0.6, yaw: 0.072),
            (after_shot: 6, pitch: 0.54, yaw: 0.096),
            (after_shot: 7, pitch: 0.48, yaw: 0.108),
            (after_shot: 8, pitch: 0.42, yaw: 0.096),
            (after_shot: 9, pitch: 0.36, yaw: 0.06),
            (after_shot: 10, pitch: 0.312, yaw: 0.012),
            (after_shot: 11, pitch: 0.276, yaw: -0.048),
            (after_shot: 12, pitch: 0.252, yaw: -0.096),
            (after_shot: 13, pitch: 0.24, yaw: -0.132),
            (after_shot: 14, pitch: 0.228, yaw: -0.156),
            (after_shot: 15, pitch: 0.216, yaw: -0.156),
            (after_shot: 16, pitch: 0.21, yaw: -0.132),
            (after_shot: 17, pitch: 0.21, yaw: -0.084),
            (after_shot: 18, pitch: 0.21, yaw: -0.024),
            (after_shot: 19, pitch: 0.21, yaw: 0.036),
            (after_shot: 20, pitch: 0.21, yaw: 0.084),
            (after_shot: 21, pitch: 0.21, yaw: 0.12),
            (after_shot: 22, pitch: 0.21, yaw: 0.132),
            (after_shot: 23, pitch: 0.21, yaw: 0.108),
            (after_shot: 24, pitch: 0.21, yaw: 0.048),
            (after_shot: 25, pitch: 0.21, yaw: -0.036),
            (after_shot: 26, pitch: 0.21, yaw: -0.108),
            (after_shot: 27, pitch: 0.21, yaw: -0.132),
            (after_shot: 28, pitch: 0.21, yaw: -0.096),
            (after_shot: 29, pitch: 0.21, yaw: -0.036),
        ],
    ),
}
