// Learnable view-kick patterns. Based on design/systems/data/mako_recoil_pattern.json, made much stronger after
// playtest round 1 (user direction, game/DESIGN_DELTAS.md section 9): recoil control is the skill check.
// Each kick is the view rotation (degrees, pitch up +, yaw right +) applied after shot `after_shot`.
// Past the last kick, the pattern loops from `loop_from_index` (0-based) for extended magazines.
// Attachments scale a pattern per axis, never its shape: stocks scale the pitch, front grips the yaw
// (attachments.ron, DESIGN_DELTAS.md section 15).
{
    "mako_recoil_pattern": (
        // Playtest round 3 (DIRECTION_LOG 18), tuned by the user after testing (standard stock, no grip): a T.
        // HOW TO TUNE: each kick is the view rotation in degrees (pitch up +, yaw right +) after shot `after_shot`;
        // aimed fire takes `ads_mult` (weapons.ron, 0.7) of every kick. Stocks scale the pitch, grips the yaw
        // (attachments.ron recoil_v / recoil_h). Past the last kick the pattern loops from `loop_from_index`.
        // The stem: kicks 1-14 go straight up (15.65 deg hip), so rounds 1-15 stack in one column. The bar: the
        // climb flattens and the gun sweeps right over kicks 15-20 (+4.16 deg), left across over 21-28 (-8.32), right
        // again over 29-36 (+8.32); a 45 or the drum keeps sweeping the same bar from kick 21. Against the first T:
        // a 15-round stem (was 10), about 70 % more total climb over a 30-round mag, a 60 % wider bar.
        loop_from_index: 20,
        kicks: [
            (after_shot: 1, pitch: 0.95, yaw: 0.0),
            (after_shot: 2, pitch: 1.05, yaw: 0.0),
            (after_shot: 3, pitch: 1.15, yaw: 0.0),
            (after_shot: 4, pitch: 1.25, yaw: 0.0),
            (after_shot: 5, pitch: 1.3, yaw: 0.0),
            (after_shot: 6, pitch: 1.3, yaw: 0.0),
            (after_shot: 7, pitch: 1.3, yaw: 0.0),
            (after_shot: 8, pitch: 1.25, yaw: 0.0),
            (after_shot: 9, pitch: 1.2, yaw: 0.0),
            (after_shot: 10, pitch: 1.15, yaw: 0.0),
            (after_shot: 11, pitch: 1.05, yaw: 0.0),
            (after_shot: 12, pitch: 1.0, yaw: 0.0),
            (after_shot: 13, pitch: 0.9, yaw: 0.0),
            (after_shot: 14, pitch: 0.8, yaw: 0.0),
            (after_shot: 15, pitch: 0.45, yaw: 0.48),
            (after_shot: 16, pitch: 0.3, yaw: 0.72),
            (after_shot: 17, pitch: 0.2, yaw: 0.88),
            (after_shot: 18, pitch: 0.12, yaw: 0.88),
            (after_shot: 19, pitch: 0.1, yaw: 0.72),
            (after_shot: 20, pitch: 0.08, yaw: 0.48),
            (after_shot: 21, pitch: 0.08, yaw: -0.56),
            (after_shot: 22, pitch: 0.08, yaw: -0.96),
            (after_shot: 23, pitch: 0.08, yaw: -1.28),
            (after_shot: 24, pitch: 0.08, yaw: -1.36),
            (after_shot: 25, pitch: 0.08, yaw: -1.36),
            (after_shot: 26, pitch: 0.08, yaw: -1.28),
            (after_shot: 27, pitch: 0.08, yaw: -0.96),
            (after_shot: 28, pitch: 0.08, yaw: -0.56),
            (after_shot: 29, pitch: 0.08, yaw: 0.56),
            (after_shot: 30, pitch: 0.08, yaw: 0.96),
            (after_shot: 31, pitch: 0.08, yaw: 1.28),
            (after_shot: 32, pitch: 0.08, yaw: 1.36),
            (after_shot: 33, pitch: 0.08, yaw: 1.36),
            (after_shot: 34, pitch: 0.08, yaw: 1.28),
            (after_shot: 35, pitch: 0.08, yaw: 0.96),
            (after_shot: 36, pitch: 0.08, yaw: 0.56),
        ],
    ),
    "skink_recoil_pattern": (
        // The round-2 Mako column x0.6 (the T is the AR's alone): a tall climb with a gentle right-then-left sway,
        // lighter on every shot. At 1200 rpm it climbs 7.58 deg in its first second (20 shots).
        loop_from_index: 20,
        kicks: [
            (after_shot: 1, pitch: 0.6, yaw: 0.0),
            (after_shot: 2, pitch: 0.66, yaw: 0.03),
            (after_shot: 3, pitch: 0.69, yaw: -0.036),
            (after_shot: 4, pitch: 0.66, yaw: 0.048),
            (after_shot: 5, pitch: 0.6, yaw: 0.072),
            (after_shot: 6, pitch: 0.54, yaw: 0.096),
            (after_shot: 7, pitch: 0.48, yaw: 0.108),
            (after_shot: 8, pitch: 0.42, yaw: 0.096),
            (after_shot: 9, pitch: 0.36, yaw: 0.06),
            (after_shot: 10, pitch: 0.312, yaw: 0.012),
            (after_shot: 11, pitch: 0.276, yaw: -0.048),
            (after_shot: 12, pitch: 0.252, yaw: -0.096),
            (after_shot: 13, pitch: 0.24, yaw: -0.132),
            (after_shot: 14, pitch: 0.228, yaw: -0.156),
            (after_shot: 15, pitch: 0.216, yaw: -0.156),
            (after_shot: 16, pitch: 0.21, yaw: -0.132),
            (after_shot: 17, pitch: 0.21, yaw: -0.084),
            (after_shot: 18, pitch: 0.21, yaw: -0.024),
            (after_shot: 19, pitch: 0.21, yaw: 0.036),
            (after_shot: 20, pitch: 0.21, yaw: 0.084),
            (after_shot: 21, pitch: 0.21, yaw: 0.12),
            (after_shot: 22, pitch: 0.21, yaw: 0.132),
            (after_shot: 23, pitch: 0.21, yaw: 0.108),
            (after_shot: 24, pitch: 0.21, yaw: 0.048),
            (after_shot: 25, pitch: 0.21, yaw: -0.036),
            (after_shot: 26, pitch: 0.21, yaw: -0.108),
            (after_shot: 27, pitch: 0.21, yaw: -0.132),
            (after_shot: 28, pitch: 0.21, yaw: -0.096),
            (after_shot: 29, pitch: 0.21, yaw: -0.036),
        ],
    ),
}
