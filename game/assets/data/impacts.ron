// Bullet holes and impact debris (val_etf/src/impacts.rs). Metres, seconds, sRGB colours.
// The art is the atlas in textures/fx/impacts/ (built by assets/fx/impacts/_src/build_atlas.py, 4 variants per
// kind); its cells are listed in textures/fx/impacts/impacts_atlas.ron.
(
    // How long a mark stays, and how long it takes to fade out at the end.
    life_s: 30.0,
    fade_s: 1.0,
    // Per PARTICLES setting (LOW, HIGH): most marks kept at once (the oldest go first); parallax layers (0 = flat
    // marks, no depth) and relief refinement steps (0 = plain parallax occlusion: cheaper, but a deep bore shows
    // banding seen head-on); whether shots throw debris (dust puffs, chips, sparks on metal).
    max_marks: (64, 128),
    parallax_layers: (8.0, 16.0),
    relief_steps: (0, 5),
    debris_on: (false, true),
    // Lifted off the surface against z-fighting (on Showhome off the art kit's surface, which can sit a few
    // millimetres in front of or behind the collision face).
    lift_m: 0.003,
    // Every mark is its kind's size times 1 +/- this (random).
    size_jitter: 0.12,
    // Wood marks run along the grain (up on walls, along the boards on floors), turned by at most this.
    grain_jitter_deg: 8.0,
    // Per surface kind: the mark's size, how it turns (Free = any angle, Grain = along the wood grain), and its
    // debris: dust and chip colours, how many dust puffs, chips and sparks one shot throws.
    kinds: {
        Plaster: (size_m: 0.18, spin: Free, dust: (238, 230, 214), chip: (204, 192, 170), puffs: 4, chips: 4, sparks: 0),
        Cladding: (size_m: 0.16, spin: Free, dust: (196, 194, 188), chip: (176, 172, 163), puffs: 3, chips: 4, sparks: 0),
        Wood: (size_m: 0.16, spin: Grain, dust: (206, 178, 136), chip: (214, 180, 132), puffs: 2, chips: 5, sparks: 0),
        Metal: (size_m: 0.12, spin: Free, dust: (150, 150, 152), chip: (120, 120, 124), puffs: 1, chips: 0, sparks: 9),
        Glass: (size_m: 0.18, spin: Free, dust: (226, 234, 238), chip: (226, 234, 238), puffs: 1, chips: 5, sparks: 0),
        Pavement: (size_m: 0.16, spin: Free, dust: (176, 170, 164), chip: (158, 152, 148), puffs: 3, chips: 4, sparks: 1),
        Soil: (size_m: 0.26, spin: Free, dust: (120, 98, 76), chip: (88, 68, 52), puffs: 4, chips: 6, sparks: 0),
    },
    // What each look of the level is made of (on Showhome only where the art kit's surface is not found, see
    // `kit`). A look not listed takes no marks (hedges, water, clips; players never do).
    looks: {
        Wall: Plaster,
        Trim: Plaster,
        Concrete: Plaster,
        CladSage: Cladding,
        CladClay: Cladding,
        Roof: Cladding,
        Fence: Wood,
        Floor: Wood,
        Prop: Wood,
        Metal: Metal,
        Vehicle: Metal,
        Accent: Metal,
        Target: Metal,
        Glass: Glass,
        Asphalt: Pavement,
        Paving: Pavement,
        TeamA: Pavement,
        TeamB: Pavement,
        Gravel: Soil,
        Ground: Soil,
    },
    // Showhome's art kit (src/impacts/kit_surface.rs): what the kit surface a shot hit is made of, by glTF material
    // name, and its average albedo (sRGB, the texture's mean in linear light times the material's colour; the
    // triangle's vertex colour tints it further, as it does on screen). It overrides the brush's look below, so a
    // mark matches what the player sees: the sage garden wall is cladding, paving on a ground brush is pavement,
    // the kerbs (invisible collision steps) take marks. None: no mark (plants, like the hedge brushes).
    // Every material of the kit's houses, ground and props needs a row (a test checks the deployed GLBs).
    kit: {
        // Plaster
        "M_Concrete": (Some(Plaster), (178, 165, 158)),
        "M_GND_Coping": (Some(Plaster), (178, 165, 158)),
        "M_GND_Pilaster": (Some(Plaster), (178, 165, 157)),
        "M_GND_Plinth": (Some(Plaster), (144, 131, 123)),
        "M_GND_WallPrinted": (Some(Plaster), (214, 200, 176)),
        "M_Insulator": (Some(Plaster), (120, 136, 120)),
        "M_ModelGreen": (Some(Plaster), (120, 150, 70)),
        "M_ModelWhite": (Some(Plaster), (231, 229, 223)),
        "M_PoleConcrete": (Some(Plaster), (178, 165, 158)),
        "M_Printed": (Some(Plaster), (214, 200, 176)),
        "M_SH_Concrete": (Some(Plaster), (178, 165, 158)),
        "M_SH_Plaster": (Some(Plaster), (230, 218, 200)),
        "M_SH_PrintedConcrete": (Some(Plaster), (214, 200, 176)),
        "M_SH_TrimSheet": (Some(Plaster), (160, 153, 142)),
        // Cladding
        "M_ArchLiner": (Some(Cladding), (29, 29, 31)),
        "M_BinGrey": (Some(Cladding), (89, 91, 93)),
        "M_BinLidBlue": (Some(Cladding), (60, 90, 140)),
        "M_BinLidBrown": (Some(Cladding), (110, 80, 55)),
        "M_BinLidGreen": (Some(Cladding), (70, 110, 60)),
        "M_Bumper": (Some(Cladding), (80, 80, 82)),
        "M_FabricOrange": (Some(Cladding), (178, 108, 66)),
        "M_FabricOrangeDark": (Some(Cladding), (168, 84, 52)),
        "M_GND_CladClay": (Some(Cladding), (207, 134, 96)),
        "M_GND_CladSage": (Some(Cladding), (145, 153, 114)),
        "M_RoofMembrane": (Some(Cladding), (77, 75, 76)),
        "M_Rubber": (Some(Cladding), (39, 39, 41)),
        "M_SH_Fabric": (Some(Cladding), (255, 255, 255)),
        "M_SH_FibreCementPaintedFace": (Some(Cladding), (218, 218, 218)),
        "M_SH_RidgeVerge": (Some(Cladding), (86, 79, 80)),
        "M_SH_RoofShingle": (Some(Cladding), (86, 79, 80)),
        "M_TankPaint": (Some(Cladding), (103, 112, 102)),
        "M_TrimCream": (Some(Cladding), (178, 165, 158)),
        "M_Tyre": (Some(Cladding), (48, 48, 50)),
        "M_WaterCover": (Some(Cladding), (109, 142, 135)),
        // Wood
        "M_Batten": (Some(Wood), (83, 72, 66)),
        "M_BoxDark": (Some(Wood), (53, 47, 41)),
        "M_BoxFace": (Some(Wood), (208, 164, 118)),
        "M_Cardboard": (Some(Wood), (208, 164, 118)),
        "M_GND_TimberDark": (Some(Wood), (66, 56, 50)),
        "M_PackingTape": (Some(Wood), (190, 160, 113)),
        "M_Picket": (Some(Wood), (226, 219, 205)),
        "M_PicketBack": (Some(Wood), (193, 187, 177)),
        "M_Plywood": (Some(Wood), (83, 72, 66)),
        "M_SH_Decking": (Some(Wood), (126, 116, 108)),
        "M_SH_OakBoards": (Some(Wood), (184, 146, 108)),
        "M_SH_Paint": (Some(Wood), (255, 255, 255)),
        "M_SH_TimberBoards": (Some(Wood), (83, 72, 66)),
        "M_ShedClay": (Some(Wood), (83, 72, 66)),
        "M_Stencil": (Some(Wood), (63, 60, 56)),
        "M_Timber": (Some(Wood), (83, 72, 66)),
        "M_TimberH": (Some(Wood), (83, 72, 66)),
        "M_WoodLeg": (Some(Wood), (92, 64, 44)),
        "M_WoodStained": (Some(Wood), (83, 72, 66)),
        "M_WoodStainedH": (Some(Wood), (83, 72, 66)),
        // Metal
        "M_AluTrim": (Some(Metal), (188, 188, 188)),
        "M_Anthracite": (Some(Metal), (60, 61, 64)),
        "M_CabinetWhite": (Some(Metal), (231, 223, 218)),
        "M_Cable": (Some(Metal), (36, 36, 39)),
        "M_Chassis": (Some(Metal), (66, 66, 69)),
        "M_DecalAccent": (Some(Metal), (206, 124, 63)),
        "M_DecalDark": (Some(Metal), (54, 49, 54)),
        "M_GH_Frame": (Some(Metal), (223, 222, 218)),
        "M_GND_Gully": (Some(Metal), (52, 50, 52)),
        "M_GND_Inspection": (Some(Metal), (155, 145, 139)),
        "M_GND_Manhole": (Some(Metal), (75, 72, 74)),
        "M_GND_SteelEdging": (Some(Metal), (98, 91, 94)),
        "M_Grating": (Some(Metal), (149, 151, 153)),
        "M_KickClay": (Some(Metal), (207, 134, 96)),
        "M_KickSage": (Some(Metal), (145, 153, 114)),
        "M_LockerBody": (Some(Metal), (197, 191, 189)),
        "M_LockerDoor": (Some(Metal), (223, 215, 212)),
        "M_Plate": (Some(Metal), (229, 226, 218)),
        "M_Rim": (Some(Metal), (181, 181, 182)),
        "M_SH_Metal": (Some(Metal), (255, 255, 255)),
        "M_SafetyYellow": (Some(Metal), (206, 148, 62)),
        "M_SteelDark": (Some(Metal), (75, 75, 77)),
        "M_SteelGalv": (Some(Metal), (155, 158, 160)),
        "M_TrimDark": (Some(Metal), (54, 49, 54)),
        "M_TruckWhite": (Some(Metal), (231, 223, 218)),
        // Glass
        "M_Amber": (Some(Glass), (237, 170, 56)),
        "M_GH_Panel": (Some(Glass), (200, 213, 205)),
        "M_GH_Roof": (Some(Glass), (216, 228, 224)),
        "M_GlassDark": (Some(Glass), (41, 48, 58)),
        "M_HeadLight": (Some(Glass), (255, 246, 229)),
        "M_LedIce": (Some(Glass), (179, 237, 255)),
        "M_SH_GlassDark": (Some(Glass), (255, 255, 255)),
        "M_SH_GlassFrost": (Some(Glass), (230, 234, 234)),
        "M_SH_LampWarm": (Some(Glass), (255, 255, 255)),
        "M_SH_SolarPanel": (Some(Glass), (53, 58, 79)),
        "M_TailLight": (Some(Glass), (179, 39, 39)),
        // Pavement
        "M_GND_Asphalt": (Some(Pavement), (112, 105, 106)),
        "M_GND_AsphaltOld": (Some(Pavement), (112, 105, 106)),
        "M_GND_Concrete": (Some(Pavement), (178, 165, 158)),
        "M_GND_Edging": (Some(Pavement), (159, 147, 141)),
        "M_GND_Kerb": (Some(Pavement), (159, 147, 141)),
        "M_GND_LineWhite": (Some(Pavement), (229, 226, 221)),
        "M_GND_LineYellow": (Some(Pavement), (231, 191, 89)),
        "M_GND_PaintClay": (Some(Pavement), (218, 112, 86)),
        "M_GND_PaintSage": (Some(Pavement), (46, 150, 136)),
        "M_GND_Paving": (Some(Pavement), (175, 162, 154)),
        "M_GND_PavingClay": (Some(Pavement), (175, 154, 144)),
        "M_GND_PavingSage": (Some(Pavement), (164, 160, 151)),
        // Soil
        "M_GND_Grass": (Some(Soil), (126, 140, 58)),
        "M_GND_GrassFar": (Some(Soil), (114, 126, 48)),
        "M_GND_Gravel": (Some(Soil), (174, 153, 137)),
        "M_GND_Mulch": (Some(Soil), (96, 74, 56)),
        "M_GND_Sand": (Some(Soil), (197, 168, 141)),
        "M_GND_Soil": (Some(Soil), (96, 74, 56)),
        "M_GND_SoilFar": (Some(Soil), (96, 74, 56)),
        "M_Soil": (Some(Soil), (96, 74, 56)),
        // no mark (plants: like the hedge brushes)
        "M_Crop": (None, (112, 150, 62)),
        "M_CropDark": (None, (74, 104, 46)),
        "M_Flower": (None, (222, 150, 170)),
        "M_FlowerWhite": (None, (236, 230, 214)),
        "M_Hedge": (None, (98, 112, 52)),
        "M_Vine": (None, (98, 112, 48)),
    },
    // The surface colour on Showhome where the art kit is not found, for the paint layer (the surface bent or
    // lifted round a hole): the texture library's palette. Other maps use each look's flat colour.
    tints: {
        Wall: (214, 200, 176),
        Trim: (221, 211, 191),
        Concrete: (178, 165, 158),
        CladSage: (145, 153, 114),
        CladClay: (207, 134, 96),
        Roof: (86, 79, 80),
        Fence: (226, 219, 205),
        Floor: (83, 72, 66),
        Vehicle: (231, 223, 218),
        Asphalt: (112, 105, 106),
        Paving: (175, 162, 154),
        Gravel: (173, 153, 137),
        Ground: (126, 140, 58),
    },
    // From afar (when a mark is about 24 px on screen, mip 3 of the atlas, and smaller) each mip of a mark is
    // darker by darken_per_mip (up to darken_max, linear) and more opaque by alpha_per_mip, so holes stay readable
    // dark dots at range instead of melting into the wall. Close up nothing changes.
    far: (from_mip: 3, darken_per_mip: 0.2, darken_max: 0.6, alpha_per_mip: 0.3),
    debris: (
        // At most this many pieces fly at once (the oldest go first).
        max: 256,
        gravity: 9.8,
        // Dust puffs drift off the surface, grow and fade; this much of their speed is left after one second.
        puff_life_s: (0.35, 0.65),
        puff_speed: (0.4, 1.1),
        puff_size_m: (0.04, 0.24),
        puff_drag: 0.08,
        puff_alpha: 0.8,
        // Chips fly out and fall.
        chip_life_s: (0.35, 0.7),
        chip_speed: (1.5, 3.5),
        chip_size_m: (0.01, 0.022),
        // Sparks: hot streaks, as long as they travel in `spark_streak_s`.
        spark_life_s: (0.06, 0.16),
        spark_speed: (3.0, 7.5),
        spark_streak_s: 0.025,
        spark_width_m: 0.014,
        // Linear HDR colour (bloom picks it up).
        spark_color: (6.0, 2.4, 0.6),
    ),
)
