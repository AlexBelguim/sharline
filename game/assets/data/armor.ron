// Health zones and halo shields. Based on design/systems/data/armors.slice.json, with the
// user's per-section armor direction (see game/DESIGN_DELTAS.md):
//   every halo arc (head / torso / arms / legs) has its own tier and its own shield pool,
//   so a torso shield can break while the leg arc still holds.
(
    zone_hp: (head: 45.0, torso: 120.0, arms: 70.0, legs: 85.0),
    weight_effects: {
        None: (move: 1.0, accel: 1.0, fuel: 1.0, slide_boost: 2.0, mantle: 1.0, energy_per_min: 0.0, cells: 0),
        Light: (move: 1.0, accel: 1.0, fuel: 1.0, slide_boost: 2.0, mantle: 1.0, energy_per_min: 2.0, cells: 1),
        Medium: (move: 0.95, accel: 0.95, fuel: 0.9, slide_boost: 1.7, mantle: 1.1, energy_per_min: 4.0, cells: 2),
        Heavy: (move: 0.88, accel: 0.85, fuel: 0.75, slide_boost: 1.3, mantle: 1.25, energy_per_min: 8.0, cells: 3),
    },
    // Shield capacity of one arc per core, indexed by tier 1..4 (the design's halo capacity),
    // scaled per zone by `zone_capacity_share`.
    capacity: {
        Bulwark: [65.0, 100.0, 130.0, 165.0],
        Volt: [50.0, 75.0, 100.0, 125.0],
        Mender: [40.0, 60.0, 80.0, 100.0],
        Phase: [35.0, 55.0, 70.0, 90.0],
    },
    zone_capacity_share: (head: 0.6, torso: 1.0, arms: 0.6, legs: 0.6),
    // Regen is per core; any hit pauses regen on every arc, a broken arc pauses it longer.
    regen: {
        Bulwark: (delay_s: 5.0, delay_after_break_s: 8.0, rate_per_s: 10.0),
        Volt: (delay_s: 4.0, delay_after_break_s: 7.0, rate_per_s: 15.0),
        Mender: (delay_s: 2.5, delay_after_break_s: 5.0, rate_per_s: 20.0),
        Phase: (delay_s: 3.5, delay_after_break_s: 6.0, rate_per_s: 15.0),
    },
    // Protection score = sum of the arc tiers (with uniform tiers this is the design's tier x zones).
    weight_bands: [(Light, 1, 4), (Medium, 5, 8), (Heavy, 9, 16)],
    // Highest tier a loadout may put on each arc. Higher leg protection is meant to be rare loot,
    // so spraying legs stays a real option against heavily armored players.
    loadout_tier_caps: (head: 4, torso: 4, arms: 3, legs: 2),
    status_effects: {
        Bulwark: "flinch (aim punch) taken -50% while shield > 0",
        Mender: "fast out-of-combat regen (see regen table)",
        Volt: "on break: shock pulse r=4 m, enemies slowed 30% for 1.5 s",
        Phase: "immune to slow effects (Volt pulse, tagging slow)",
    },
    presets: [
        (id: "arm_none", name: "No halo", core: None, tiers: (head: 0, torso: 0, arms: 0, legs: 0)),
        (id: "arm_phase_runner", name: "Phase Runner", core: Some(Phase), tiers: (head: 0, torso: 1, arms: 0, legs: 0)),
        (id: "arm_phase_ghost", name: "Phase Ghost", core: Some(Phase), tiers: (head: 4, torso: 0, arms: 0, legs: 0)),
        (id: "arm_mender_scout", name: "Mender Scout", core: Some(Mender), tiers: (head: 2, torso: 2, arms: 0, legs: 0)),
        (id: "arm_volt_line", name: "Volt Line", core: Some(Volt), tiers: (head: 0, torso: 3, arms: 3, legs: 0)),
        (id: "arm_bulwark_assault", name: "Bulwark Assault", core: Some(Bulwark), tiers: (head: 3, torso: 3, arms: 3, legs: 0)),
        // Rare-loot leg arc (T4 legs is above the loadout cap).
        (id: "arm_bulwark_jugg", name: "Bulwark Juggernaut", core: Some(Bulwark), tiers: (head: 4, torso: 4, arms: 4, legs: 4)),
        // Mixed-tier examples enabled by per-section tiers.
        (id: "arm_bulwark_vanguard", name: "Bulwark Vanguard", core: Some(Bulwark), tiers: (head: 2, torso: 4, arms: 2, legs: 1)),
        (id: "arm_mender_medic", name: "Mender Medic", core: Some(Mender), tiers: (head: 1, torso: 3, arms: 1, legs: 1)),
    ],
    // One line per core on the Loadout screen's core cards (display copy).
    core_blurbs: {
        Bulwark: "Most shield, slow regen",
        Mender: "Regens out of combat",
        Volt: "Break = shock pulse",
        Phase: "Immune to slow",
    },
)
