// The look of smoke grenades and molotovs (val_etf/src/render/throw_fx.rs, assets/shaders/throwables.wgsl). Visual
// only: sizes, times, sight and damage are gameplay numbers in throwables.ron. Built the way the hedges are
// (foliage.rs): soft painted cards filling the volume, one mesh per cloud or fire, lit with light wrap. Groups of
// four follow the VIDEO quality preset [LOW, MEDIUM, HIGH, ULTRA]; every preset hides what is behind a cloud
// alike (fewer, bigger puffs on LOW). Lengths are metres, colours linear RGB.
(
    smoke: (
        // Puff cards per cloud, merged into one mesh. Each faces the camera; the cloud's puffs fill its volume.
        cards: (56, 72, 88, 104),
        // Puff edge length at full size with `cards[HIGH]` cards, smallest and largest (other presets scale the
        // size so the cloud stays as covered).
        card_size: (2.2, 3.6),
        // The puff centres fill this share of the cloud's radii (the rim puffs reach past it by half a card).
        fill: 0.82,
        // A new cloud's puffs start at this share of their size and grow with the cloud.
        min_card_scale: 0.35,
        // The painted puffs' colour, per-puff brightness jitter, and the darkening toward the bottom and the core.
        tint: (0.80, 0.81, 0.82),
        value_jitter: 0.07,
        ao_bottom: 0.66,
        ao_core: 0.82,
        // Light: wrap past the terminator, light through the smoke toward the sun (a share of its diffuse light)
        // and its tightness, and the ambient's weight. A puff the level shadows from the sun gets sun_shade of it.
        wrap: 0.7,
        translucency: 0.55,
        translucency_power: 4.0,
        ambient: 1.0,
        sun_shade: 0.2,
        // The alpha of a puff in a full-density cloud (the density thins it out at the end).
        opacity: 0.92,
        // Slow drift: each puff wanders this far around its place, the cloud turns this fast (rad/s), each puff
        // rolls this fast (rad/s), and a thinning cloud spreads out by fade_spread of its size.
        drift_m: 0.3,
        swirl: 0.04,
        spin: 0.10,
        fade_spread: 0.18,
        // Puffs this close to the camera fade out (from near_fade.1 to near_fade.0 m) and then vanish: inside a
        // cloud the screen fills with the puffs ahead, not one card in the face.
        near_fade: (0.5, 1.4),
        // Where a puff meets the level it fades over this depth (with a depth prepass: TAA, SSAO).
        soft_depth_m: 0.5,
        // The puffs are re-sorted back to front when the view of the cloud turns this much (degrees).
        resort_deg: 8.0,
        // Bullet tunnels: a shot through the cloud clears a see-through tube of radius_m (edge soft_m) along its
        // path; it stays clear, then fills back in over the last refill_s of life_s. A shot opens every cloud it
        // passes within `reach` times the cloud's size.
        tunnel: (radius_m: 0.55, soft_m: 0.35, life_s: 2.6, refill_s: 1.3, reach: 1.15),
    ),
    fire: (
        // Flame cards and ember sparks per fire, merged into one mesh (flames stand up and turn to the camera).
        flames: (24, 32, 40, 48),
        embers: (8, 12, 18, 24),
        // Flame width (smallest, largest; with `flames[HIGH]`), height over width, flicker (a share of the
        // height) and its rate (Hz, smallest and largest).
        flame_size: (0.55, 1.05),
        flame_aspect: 1.7,
        flicker: 0.28,
        flicker_hz: (4.0, 9.0),
        // Unlit, additive: tint times glow (the ember aura's way).
        tint: (1.0, 0.52, 0.16),
        glow: 3.2,
        ember_tint: (1.0, 0.62, 0.22),
        ember_glow: 6.0,
        ember_size: 0.05,
        ember_rise_m: 1.9,
        ember_rise_s: 1.3,
        // The flames shrink away over the last fade_s of the burn, and as fast once smoke puts them out.
        fade_s: 0.6,
        // A little light (a point light without shadows): colour, lumens, range and flicker share.
        light_color: (1.0, 0.58, 0.26),
        light_lumens: 40000.0,
        light_range_m: 8.0,
        light_flicker: 0.22,
    ),
    grenade: (
        // A smoke canister and a molotov bottle in flight (a tumbling can and bottle, the molotov's rag lit).
        smoke_color: (0.34, 0.38, 0.31),
        molotov_color: (0.52, 0.30, 0.08),
        // The same existing meshes held beside the camera while selected/charging.
        held_scale: 1.35,
        held_charge_offset: (0.025, 0.03, 0.04),
        held_tilt_deg: 20.0,
        rag_glow: 6.0,
        tumble_rps: 1.6,
    ),
)
