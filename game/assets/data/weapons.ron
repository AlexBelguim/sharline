// Weapon stats for the slice. Mirrors design/systems/data/weapons.slice.json (the design data is the
// source of truth; `cargo test -p vetf_sim` fails if these drift), except where the user changed the
// direction since (listed in game/DESIGN_DELTAS.md):
//   - halo penetration comes from the ammo (weapon class x ammo type x tier, ammo.ron), not `shield_pierce`;
//   - aiming lowers the fire rate (`ads_rpm_mult`) and the recoil (`recoil.ads_mult`);
//   - aiming never slows you (no `move_mult_ads`);
//   - playtest round 1 gun tuning: harder-hitting Mako, SMG strong close / weak past 25 m, much faster ADS,
//     stronger recoil with no recovery mid-spray (DESIGN_DELTAS.md section 9);
//   - playtest round 2 recoil and bloom (DESIGN_DELTAS.md section 12): standing still, a gun has no random spread
//     at all, hip or aimed (no `hip_still` / `ads_still`), only its fixed recoil pattern (the Warden's kick has a
//     fixed yaw, not a random one); moving adds random bloom on top, Apex-style: hip fire opens with speed and
//     state (walk < jog < sprint, slide, air, zipline, jetpack) and sustained fire, aimed fire only a little
//     (`ads_move_mult`, `bloom_max_ads`); the raise from a sprint (`sprint_to_fire_s`) is about the ADS time.
// Angles in degrees, distances in metres, times in seconds.
(
    tick_hz: 60,
    weapons: [
        (
            id: "ar7_mako",
            name: "AR-7 Mako",
            cls: assault_rifle,
            ballistics: hitscan,
            // 4 torso hits through the default Mender Scout halo (60 shield + 120 HP) out to ~28 m, 3 on a bare
            // torso; the falloff keeps the design's shape (x0.84 at 50 m, x0.73 at 80 m).
            damage: 46.0,
            falloff: [(0.0, 46.0), (25.0, 46.0), (50.0, 38.5), (80.0, 33.5)],
            min_damage: 33.5,
            max_range_m: 300.0,
            // Head x1.5: two head hits kill through any T3 head arc within 25 m (one on a bare head).
            zone_mult: (head: 1.5, torso: 1.0, arms: 0.8, legs: 0.85),
            rpm: 720.0,
            ads_rpm_mult: 0.85,
            fire_modes: [auto, semi],
            mag_default: "mag_30",
            reload_tactical_s: 2.1,
            reload_empty_s: 2.65,
            reload_fast_drop_s: 1.6,
            mag_check_s: 1.0,
            equip_s: 0.7,
            holster_s: 0.4,
            ads_s: 0.13,
            // A hip shot from a sprint comes a tick before an aimed one (aim held caps the raise at the ADS time).
            sprint_to_fire_s: 0.12,
            move_mult_held: 1.0,
            // Random cone only while moving (standing still under 0.48 m/s: the fixed pattern alone). Hip: 1.2 deg
            // walking, 2.6 jogging, 3.0 sprinting, sliding, on a zipline or the jetpack, 4.0 in the air, plus up to
            // 1.6 of sustained-fire bloom (14 moving shots, 1.1 s). Aimed: x0.04 and at most 0.04 of bloom, so at
            // most 0.2 deg (8.7 cm at 25 m: inside a head). The bloom waits longer than any automatic fire interval
            // (aimed 600 rpm: 0.1 s) before it settles, so it builds through a spray, and settles in about 0.7 s.
            spread_deg: (
                move_threshold_frac: 0.1,
                crouch_mult: 0.85,
                walk_hip: 1.2,
                move_full_hip: 2.6,
                sprint_hip: 3.0,
                air: 4.0,
                slide: 3.0,
                zipline: 3.0,
                jetpack: 3.0,
                ads_move_mult: 0.04,
                bloom_max_ads: 0.04,
                bloom_per_shot_hip: 0.12,
                bloom_max_hip: 1.6,
                bloom_decay_delay_s: 0.15,
                bloom_decay_deg_per_s: 3.0,
            ),
            recoil: (
                pattern: "mako_recoil_pattern",
                ads_mult: 0.7,
                hip_mult: 1.0,
                crouch_mult: 0.9,
                reset_after_s: 0.3,
                // Recovery waits longer than any automatic fire interval (600 rpm aimed = 0.1 s), so a spray
                // never recovers between shots: the pattern is the same every time.
                recover_frac: 0.5,
                recover_delay_s: 0.15,
                recover_deg_per_s: 20.0,
                // A visible kick per shot that is back before the next one (720 rpm = 0.083 s apart).
                view_punch_visual_deg: 0.5,
                view_punch_return_s: 0.07,
            ),
        ),
        (
            id: "vk50_warden",
            name: "VK-50 Warden",
            cls: bolt_sniper,
            ballistics: hitscan,
            damage: 160.0,
            falloff: [(0.0, 160.0), (60.0, 160.0), (120.0, 150.0), (150.0, 140.0)],
            min_damage: 140.0,
            max_range_m: 500.0,
            zone_mult: (head: 2.0, torso: 1.0, arms: 0.8, legs: 0.85),
            rpm: 48.0,
            ads_rpm_mult: 1.0,
            bolt_cycle_s: Some(1.25),
            fire_modes: [bolt],
            mag_default: "mag_5",
            reload_tactical_s: 2.8,
            reload_empty_s: 3.4,
            reload_fast_drop_s: 2.3,
            mag_check_s: 1.2,
            equip_s: 1.0,
            holster_s: 0.55,
            ads_s: 0.22,
            sprint_to_fire_s: 0.2,
            move_mult_held: 0.93,
            // Moving hip fire with a sniper is a gamble (4 deg walking, 8 jogging, 9 faster, 10 on the jetpack);
            // aimed it is x0.01, at most 0.1 deg (8.7 cm at 50 m: inside a head). One shot per bolt: no bloom.
            spread_deg: (
                move_threshold_frac: 0.1,
                crouch_mult: 0.85,
                walk_hip: 4.0,
                move_full_hip: 8.0,
                sprint_hip: 9.0,
                air: 9.0,
                slide: 9.0,
                zipline: 9.0,
                jetpack: 10.0,
                ads_move_mult: 0.01,
            ),
            sway: Some((
                idle_amp_deg: 0.12,
                period_s: 3.0,
                hold_breath_s: 4.0,
                exhausted_mult: 2.0,
                exhausted_s: 2.0,
            )),
            // One big kick per shot, the same every time: 3.5 deg up and 0.2 deg right.
            recoil: (
                kick_pitch_deg: 3.5,
                kick_yaw_deg: 0.2,
                recover_frac: 0.7,
                recover_s: 0.35,
            ),
            scope: Some((
                zoom_levels: [6.0, 12.0],
                glint_min_range_m: 25.0,
                glint_cone_deg: 15.0,
            )),
        ),
        // SMG (user direction; balance pass v2, see game/DESIGN_DELTAS.md): fast fire, low damage, low pen. The only
        // gun that loads RIP. No design entry yet, so the design sync test skips it.
        (
            id: "sk9_skink",
            name: "SK-9 Skink",
            cls: smg,
            ballistics: hitscan,
            // Gun tuning (playtest round 1): it must out-kill the harder Mako up close and fade fast past it.
            // 5 torso hits through a Mender Scout to 10 m (Mako: 4 at 720 rpm, so 0.20 s against 0.25 s), then
            // a steep drop: 16 at 25 m and 10 past 40 m, under 60 % of the Mako's damage per second from 25 m.
            damage: 36.0,
            falloff: [(0.0, 36.0), (10.0, 36.0), (25.0, 16.0), (40.0, 10.0)],
            min_damage: 10.0,
            max_range_m: 150.0,
            // Head x1.0: a spray gun. Keeps every Skink round (RIP III: 36 x 1.2 = 43.2) under a bare head's 45 HP.
            zone_mult: (head: 1.0, torso: 1.0, arms: 0.8, legs: 0.85),
            rpm: 1200.0,
            ads_rpm_mult: 0.75,
            fire_modes: [auto, semi],
            mag_default: "skink_mag_40",
            reload_tactical_s: 1.8,
            reload_empty_s: 2.3,
            reload_fast_drop_s: 1.4,
            mag_check_s: 0.9,
            equip_s: 0.5,
            holster_s: 0.35,
            ads_s: 0.11,
            sprint_to_fire_s: 0.1,
            move_mult_held: 1.0,
            // The Mako's moving cones, a little tighter at a walk; the bloom per shot is smaller because it fires
            // faster (the same per second). Aimed: at most 0.2 deg, inside a head at 25 m.
            spread_deg: (
                move_threshold_frac: 0.1,
                crouch_mult: 0.85,
                walk_hip: 1.0,
                move_full_hip: 2.6,
                sprint_hip: 3.0,
                air: 4.0,
                slide: 3.0,
                zipline: 3.0,
                jetpack: 3.0,
                ads_move_mult: 0.04,
                bloom_max_ads: 0.04,
                bloom_per_shot_hip: 0.072,
                bloom_max_hip: 1.6,
                bloom_decay_delay_s: 0.15,
                bloom_decay_deg_per_s: 3.0,
            ),
            recoil: (
                pattern: "skink_recoil_pattern",
                ads_mult: 0.7,
                hip_mult: 1.0,
                crouch_mult: 0.9,
                reset_after_s: 0.3,
                recover_frac: 0.5,
                recover_delay_s: 0.15,
                recover_deg_per_s: 20.0,
                // Back before the next shot (1200 rpm = 0.05 s apart).
                view_punch_visual_deg: 0.3,
                view_punch_return_s: 0.045,
            ),
        ),
    ],
    // Damage that hits an already-broken limb flows to the torso at this factor.
    spill_to_torso: (arms: 0.6, legs: 0.7),
)
