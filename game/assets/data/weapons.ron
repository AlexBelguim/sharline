// Weapon stats for the slice. Mirrors design/systems/data/weapons.slice.json (the design data is the
// source of truth; `cargo test -p vetf_sim` fails if these drift), except where the user changed the
// direction since (listed in game/DESIGN_DELTAS.md):
//   - halo penetration comes from the ammo (weapon class x ammo type x tier, ammo.ron), not `shield_pierce`;
//   - aiming lowers the fire rate (`ads_rpm_mult`) and the recoil (`recoil.ads_mult`);
//   - an aimed first shot ignores the airborne penalty and slight movement (`ads_first_shot`);
//   - bloom only builds up while moving, so standing still you fight the learnable pattern alone.
// Angles in degrees, distances in metres, times in seconds.
(
    tick_hz: 60,
    weapons: [
        (
            id: "ar7_mako",
            name: "AR-7 Mako",
            cls: assault_rifle,
            ballistics: hitscan,
            damage: 37.0,
            falloff: [(0.0, 37.0), (25.0, 37.0), (50.0, 31.0), (80.0, 27.0)],
            min_damage: 27.0,
            max_range_m: 300.0,
            zone_mult: (head: 1.3, torso: 1.0, arms: 0.8, legs: 0.85),
            rpm: 720.0,
            ads_rpm_mult: 0.85,
            ads_first_shot: Some((air_accurate: true, move_tolerance_frac: 0.35)),
            fire_modes: [auto, semi],
            mag_default: "mag_30",
            reload_tactical_s: 2.1,
            reload_empty_s: 2.65,
            reload_fast_drop_s: 1.6,
            mag_check_s: 1.0,
            equip_s: 0.7,
            holster_s: 0.4,
            ads_s: 0.22,
            sprint_to_fire_s: 0.2,
            move_mult_held: 1.0,
            move_mult_ads: 0.6,
            spread_deg: (
                ads_still: 0.08,
                hip_still: 0.7,
                crouch_mult: 0.85,
                move_full_ads: 1.4,
                move_full_hip: 2.6,
                move_threshold_frac: 0.3,
                air: 4.0,
                slide: 1.8,
                zipline: 2.0,
                jetpack: 3.0,
                bloom_per_shot_ads: 0.05,
                bloom_max_ads: 0.8,
                bloom_per_shot_hip: 0.12,
                bloom_max_hip: 1.6,
                bloom_decay_delay_s: 0.08,
                bloom_decay_deg_per_s: 3.0,
            ),
            recoil: (
                pattern: "mako_recoil_pattern",
                ads_mult: 0.7,
                hip_mult: 1.0,
                crouch_mult: 0.9,
                reset_after_s: 0.3,
                recover_frac: 0.6,
                recover_delay_s: 0.1,
                recover_deg_per_s: 15.0,
                view_punch_visual_deg: 0.15,
            ),
        ),
        (
            id: "vk50_warden",
            name: "VK-50 Warden",
            cls: bolt_sniper,
            ballistics: hitscan,
            damage: 160.0,
            falloff: [(0.0, 160.0), (60.0, 160.0), (120.0, 150.0), (150.0, 140.0)],
            min_damage: 140.0,
            max_range_m: 500.0,
            zone_mult: (head: 2.0, torso: 1.0, arms: 0.8, legs: 0.85),
            rpm: 48.0,
            ads_rpm_mult: 1.0,
            bolt_cycle_s: Some(1.25),
            fire_modes: [bolt],
            mag_default: "mag_5",
            reload_tactical_s: 2.8,
            reload_empty_s: 3.4,
            reload_fast_drop_s: 2.3,
            mag_check_s: 1.2,
            equip_s: 1.0,
            holster_s: 0.55,
            ads_s: 0.38,
            sprint_to_fire_s: 0.32,
            move_mult_held: 0.93,
            move_mult_ads: 0.45,
            spread_deg: (
                ads_still: 0.0,
                ads_unsettled: Some(3.0),
                hip_still: 6.0,
                crouch_mult: 0.85,
                move_full_ads: 3.0,
                move_full_hip: 8.0,
                move_threshold_frac: 0.2,
                air: 8.0,
                slide: 6.0,
                zipline: 6.0,
                jetpack: 10.0,
            ),
            sway: Some((
                idle_amp_deg: 0.12,
                period_s: 3.0,
                hold_breath_s: 4.0,
                exhausted_mult: 2.0,
                exhausted_s: 2.0,
            )),
            recoil: (
                kick_pitch_deg: 3.5,
                kick_yaw_rand_deg: 0.4,
                recover_frac: 0.7,
                recover_s: 0.35,
            ),
            scope: Some((
                zoom_levels: [6.0, 12.0],
                glint_min_range_m: 25.0,
                glint_cone_deg: 15.0,
            )),
        ),
        // SMG (user direction; balance pass v2, see game/DESIGN_DELTAS.md): fast fire, low damage, low pen. The only
        // gun that loads RIP. No design entry yet, so the design sync test skips it.
        (
            id: "sk9_skink",
            name: "SK-9 Skink",
            cls: smg,
            ballistics: hitscan,
            damage: 24.0,
            falloff: [(0.0, 24.0), (10.0, 24.0), (30.0, 13.0)],
            min_damage: 13.0,
            max_range_m: 150.0,
            zone_mult: (head: 1.3, torso: 1.0, arms: 0.8, legs: 0.85),
            rpm: 1200.0,
            ads_rpm_mult: 0.75,
            ads_first_shot: Some((air_accurate: true, move_tolerance_frac: 0.35)),
            fire_modes: [auto, semi],
            mag_default: "skink_mag_40",
            reload_tactical_s: 1.8,
            reload_empty_s: 2.3,
            reload_fast_drop_s: 1.4,
            mag_check_s: 0.9,
            equip_s: 0.5,
            holster_s: 0.35,
            ads_s: 0.18,
            sprint_to_fire_s: 0.15,
            move_mult_held: 1.0,
            move_mult_ads: 0.7,
            spread_deg: (
                ads_still: 0.1,
                hip_still: 0.55,
                crouch_mult: 0.85,
                move_full_ads: 1.4,
                move_full_hip: 2.6,
                move_threshold_frac: 0.3,
                air: 4.0,
                slide: 1.8,
                zipline: 2.0,
                jetpack: 3.0,
                bloom_per_shot_ads: 0.03,
                bloom_max_ads: 0.8,
                bloom_per_shot_hip: 0.072,
                bloom_max_hip: 1.6,
                bloom_decay_delay_s: 0.08,
                bloom_decay_deg_per_s: 3.0,
            ),
            recoil: (
                pattern: "skink_recoil_pattern",
                ads_mult: 0.7,
                hip_mult: 1.0,
                crouch_mult: 0.9,
                reset_after_s: 0.3,
                recover_frac: 0.6,
                recover_delay_s: 0.1,
                recover_deg_per_s: 15.0,
                view_punch_visual_deg: 0.12,
            ),
        ),
    ],
    // Damage that hits an already-broken limb flows to the torso at this factor.
    spill_to_torso: (arms: 0.6, legs: 0.7),
)
